#!/bin/sh
# Wire RAK7392 on-board peripherals exposed by the rak7392 device-tree
# overlay. Runs once on first boot. Idempotent — re-running is safe.

. /lib/functions.sh
. /lib/functions/rak-identity.sh

log() { logger -t rak7392-hw "$@"; }

# ---- LED trigger bindings ---------------------------------------------------
# The RGB USER LED (GPIO18/19/20, active low) is the only software-drivable
# indicator on this board — PWR and STATUS are hardware-driven.

if [ ! -e /sys/class/leds/rak7392:green:user ]; then
	log "warning: rak7392:green:user not present — overlay rak7392 may not be applied"
fi

# The WAN device name is not fixed (r8125 and r8169 race for eth1..eth3), so
# resolve it by driver rather than hardcoding it.
wan_dev=$(rak_netdev_by_driver r8125)
wan_dev="${wan_dev%% *}"
green_trigger='netdev'
if [ -z "$wan_dev" ]; then
	log "warning: no r8125 netdev — green USER LED left untriggered"
	green_trigger='none'
fi

# Replace any pre-existing entries with the same name so re-runs don't pile up.
while uci -q delete system.@led[0]; do :; done >/dev/null 2>&1

uci -q batch <<EOF
add system led
set system.@led[-1].name='user_green'
set system.@led[-1].sysfs='rak7392:green:user'
set system.@led[-1].default='0'
set system.@led[-1].trigger='$green_trigger'
EOF

[ "$green_trigger" = "netdev" ] && uci -q batch <<EOF
set system.@led[-1].dev='$wan_dev'
set system.@led[-1].mode='link tx rx'
EOF

# Red is reserved for a fault indication. Blue is deliberately left on trigger
# 'none' so chirpstack-concentratord-slot1's init script can drive its
# brightness directly to signal "concentratord up" — a trigger here would own
# brightness and silently override those writes.
uci -q batch <<'EOF'
add system led
set system.@led[-1].name='user_red'
set system.@led[-1].sysfs='rak7392:red:user'
set system.@led[-1].default='0'
set system.@led[-1].trigger='none'

add system led
set system.@led[-1].name='user_blue'
set system.@led[-1].sysfs='rak7392:blue:user'
set system.@led[-1].default='0'
set system.@led[-1].trigger='none'
EOF
uci commit system

# ---- RTC sync ---------------------------------------------------------------
# PCF85063 has battery-backed time; pull it into the system clock so chronyd /
# sysfixtime doesn't have to wait for NTP before LoRaWAN-relevant clocks are
# right.
if [ -e /dev/rtc0 ]; then
	hwclock --hctosys --rtc=/dev/rtc0 || log "warning: hwclock --hctosys failed"
else
	log "warning: /dev/rtc0 not present — PCF85063 driver may not be loaded"
fi

# ---- Hardware presence sanity log ------------------------------------------
for probe in \
	"/sys/bus/i2c/devices/1-0051:RTC PCF85063" \
; do
	path="${probe%%:*}"
	name="${probe#*:}"
	if [ ! -e "$path" ]; then
		log "missing: $name at $path"
	fi
done

exit 0
