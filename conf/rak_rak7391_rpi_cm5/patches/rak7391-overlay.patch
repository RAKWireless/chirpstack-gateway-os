Index: openwrt/target/linux/bcm27xx/modules/hwmon.mk
===================================================================
--- openwrt.orig/target/linux/bcm27xx/modules/hwmon.mk
+++ openwrt/target/linux/bcm27xx/modules/hwmon.mk
@@ -32,3 +32,18 @@
 endef
 
 $(eval $(call KernelPackage,hwmon-raspberrypi))
+
+define KernelPackage/hwmon-shtc1
+  TITLE:=Sensirion SHTC1/SHTC3 humidity+temperature sensor
+  KCONFIG:=CONFIG_SENSORS_SHTC1
+  FILES:=$(LINUX_DIR)/drivers/hwmon/shtc1.ko
+  AUTOLOAD:=$(call AutoLoad,60,shtc1)
+  $(call AddDepends/hwmon,+kmod-i2c-core)
+endef
+
+define KernelPackage/hwmon-shtc1/description
+  Kernel module for the Sensirion SHTC1, SHTW1, and SHTC3
+  humidity and temperature sensors.
+endef
+
+$(eval $(call KernelPackage,hwmon-shtc1))
Index: openwrt/target/linux/bcm27xx/modules/other.mk
===================================================================
--- openwrt.orig/target/linux/bcm27xx/modules/other.mk
+++ openwrt/target/linux/bcm27xx/modules/other.mk
@@ -139,3 +139,21 @@
 endef
 
 $(eval $(call KernelPackage,rp1-mailbox))
+
+
+define KernelPackage/input-pwm-beeper
+  SUBMENU:=$(OTHER_MENU)
+  TITLE:=PWM beeper support
+  KCONFIG:= \
+    CONFIG_INPUT_MISC=y \
+    CONFIG_INPUT_PWM_BEEPER
+  FILES:=$(LINUX_DIR)/drivers/input/misc/pwm-beeper.ko
+  AUTOLOAD:=$(call AutoLoad,50,pwm-beeper)
+  DEPENDS:=@TARGET_bcm27xx +kmod-input-core
+endef
+
+define KernelPackage/input-pwm-beeper/description
+  This enables playing beeps and tones through a PWM-driven buzzer.
+endef
+
+$(eval $(call KernelPackage,input-pwm-beeper))
