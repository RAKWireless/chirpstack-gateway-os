Index: openwrt/target/linux/bcm27xx/modules/hwmon.mk
===================================================================
--- openwrt.orig/target/linux/bcm27xx/modules/hwmon.mk
+++ openwrt/target/linux/bcm27xx/modules/hwmon.mk
@@ -32,3 +32,18 @@
 endef
 
 $(eval $(call KernelPackage,hwmon-raspberrypi))
+
+define KernelPackage/hwmon-shtc1
+  TITLE:=Sensirion SHTC1/SHTC3 humidity+temperature sensor
+  KCONFIG:=CONFIG_SENSORS_SHTC1
+  FILES:=$(LINUX_DIR)/drivers/hwmon/shtc1.ko
+  AUTOLOAD:=$(call AutoLoad,60,shtc1)
+  $(call AddDepends/hwmon,+kmod-i2c-core)
+endef
+
+define KernelPackage/hwmon-shtc1/description
+  Kernel module for the Sensirion SHTC1, SHTW1, and SHTC3
+  humidity and temperature sensors.
+endef
+
+$(eval $(call KernelPackage,hwmon-shtc1))
